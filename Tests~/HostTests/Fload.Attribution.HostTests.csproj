<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the package's pure C# (argument rules, the iOS version check) on .NET. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Fload.Attribution.HostTests</AssemblyName>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HostTests.cs" />
    <Compile Include="$(PackageRoot)Runtime/ArgumentRules.cs" />
    <Compile Include="$(PackageRoot)Runtime/FloadAttribution.cs" />
    <Compile Include="InactiveNativeBridge.cs" />
    <Compile Include="$(PackageRoot)Editor/IosTargetVersion.cs" />
  </ItemGroup>
</Project>
